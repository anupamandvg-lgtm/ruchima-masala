# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Firebase client config (safe to expose — these are public identifiers) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "1" to connect to local Firebase emulators (Auth + Firestore) when
# running on localhost. Leave unset in production.
NEXT_PUBLIC_EMULATOR=

# ── Firebase Admin SDK (server-only — keep secret) ──────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full private key, keeping \n escapes, wrapped in quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# From the Razorpay Dashboard → Settings → API Keys (test or live key pair —
# which one you use decides sandbox vs production, there's no separate env flag).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Settings → Webhooks, after creating the webhook pointed at /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=

# ── Ola Maps (Krutrim) — address autocomplete / reverse geocode ────────────
OLA_MAPS_API_KEY=

# ── Courier aggregator (Shiprocket/Delhivery-style) — leave unset for MOCK mode ──
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
