# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# From the Razorpay Dashboard → Settings → API Keys (test or live key pair —
# which one you use decides sandbox vs production, there's no separate env flag).
# Required — there is no MOCK mode, checkout will fail without real keys.
RAZORPAY_KEY_ID=rzp_test_Tf8ITbsIuVQQkr
RAZORPAY_KEY_SECRET=jweVN0CgYXU9ex6UXrpMID81
# secret from RAZORPAY_KEY_SECRET so a leak of one doesn't expose the other.
RAZORPAY_WEBHOOK_SECRET=aX8JBa_kiDu4G9J
# PUBLIC — safe to expose. Mirrors RAZORPAY_KEY_ID for the Checkout.js widget
# running in the browser. Keep this in sync with RAZORPAY_KEY_ID above.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_Tf8ITbsIuVQQkr

